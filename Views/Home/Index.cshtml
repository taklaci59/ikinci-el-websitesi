@{
    ViewData["Title"] = "Hoş Geldiniz";
}

<main class="min-h-[80vh] flex flex-col items-center justify-center px-margin-mobile md:px-margin-desktop py-xl text-center">
    <div class="max-w-3xl animate-in fade-in slide-in-from-bottom-8 duration-1000">
        <h1 class="font-display-lg text-display-lg mb-lg bg-gradient-to-r from-primary to-primary-fixed-dim bg-clip-text text-transparent">
            Yeni Bir Başlangıca Hazır mısınız?
        </h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant mb-xl leading-relaxed">
            Web siteniz şu an sıfırlandı ve yeni vizyonunuz için tertemiz bir sayfa açıldı. 
            Burada hayalinizdeki projeyi birlikte inşa etmeye başlayabiliriz.
        </p>
        <div class="flex flex-wrap justify-center gap-md">
            <button class="bg-primary text-on-primary px-xl py-md font-label-md text-label-md font-bold rounded-full shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all">
                Hemen Başlayalım
            </button>
            <button class="bg-surface border border-outline px-xl py-md font-label-md text-label-md font-bold rounded-full hover:bg-surface-container transition-all">
                Daha Fazla Bilgi
            </button>
        </div>
    </div>
</main>
