@model ikincelwebsitesi.Models.ViewModels.PagedList<ikincelwebsitesi.Models.Listing>

@{
    ViewData["Title"] = "İlanlar";
    var categories = ViewBag.Categories as List<ikincelwebsitesi.Models.Category>;
}

<div class="flex flex-col md:flex-row gap-6">
    <!-- Filters -->
    <div class="w-full md:w-1/4">
        <div class="card bg-base-100 shadow-xl">
            <div class="card-body">
                <h2 class="card-title text-lg font-bold mb-4">Filtrele</h2>
                <form method="get" asp-action="Index">
                    <div class="form-control mb-4">
                        <label class="label"><span class="label-text">Arama</span></label>
                        <input type="text" name="search" value="@ViewBag.Search" placeholder="Ne arıyorsunuz?" class="input input-bordered w-full" />
                    </div>
                    
                    <div class="form-control mb-4">
                        <label class="label"><span class="label-text">Kategori</span></label>
                        <select name="categoryId" class="select select-bordered w-full">
                            <option value="">Tümü</option>
                            @if (categories != null)
                            {
                                foreach (var cat in categories)
                                {
                                    if (ViewBag.CategoryId == cat.Id)
                                    {
                                        <option value="@cat.Id" selected>@cat.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <div class="grid grid-cols-2 gap-2 mb-6">
                        <div class="form-control">
                            <label class="label"><span class="label-text">Min Fiyat</span></label>
                            <input type="number" name="minPrice" value="@ViewBag.MinPrice" placeholder="0" class="input input-bordered w-full" />
                        </div>
                        <div class="form-control">
                            <label class="label"><span class="label-text">Max Fiyat</span></label>
                            <input type="number" name="maxPrice" value="@ViewBag.MaxPrice" placeholder="10000" class="input input-bordered w-full" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-full">Uygula</button>
                    <a asp-action="Index" class="btn btn-outline btn-secondary w-full mt-2">Temizle</a>
                </form>
            </div>
        </div>
    </div>

    <!-- Listings Grid -->
    <div class="w-full md:w-3/4">
        <h1 class="text-2xl font-bold mb-6">Tüm İlanlar</h1>
        
        @if (Model.Items.Count == 0)
        {
            <div class="alert alert-info shadow-lg">
                <div>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current flex-shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <span>Arama kriterlerinize uygun ilan bulunamadı.</span>
                </div>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var listing in Model.Items)
                {
                    <div class="card bg-base-100 shadow-xl hover:shadow-2xl transition-all">
                        <figure class="h-48 overflow-hidden bg-base-200">
                            @if (!string.IsNullOrEmpty(listing.ImageUrl))
                            {
                                <img src="@listing.ImageUrl" alt="@listing.Title" class="w-full h-full object-cover" />
                            }
                            else
                            {
                                <div class="flex items-center justify-center h-full text-base-content/50">Görsel Yok</div>
                            }
                        </figure>
                        <div class="card-body p-4">
                            <div class="badge badge-secondary badge-outline mb-2">@listing.Category?.Name</div>
                            <h2 class="card-title text-lg truncate" title="@listing.Title">@listing.Title</h2>
                            <p class="text-2xl font-bold text-primary my-2">@listing.Price.ToString("C")</p>
                            <p class="text-xs text-base-content/70">@listing.CreatedAt.ToString("dd MMM yyyy")</p>
                            <div class="card-actions justify-end mt-4">
                                <a asp-action="Details" asp-route-id="@listing.Id" class="btn btn-primary btn-sm">İncele</a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="join mt-8 flex justify-center">
                    @if (Model.HasPreviousPage)
                    {
                        <a asp-action="Index" asp-route-page="@(Model.PageNumber - 1)" asp-route-search="@ViewBag.Search" asp-route-minPrice="@ViewBag.MinPrice" asp-route-maxPrice="@ViewBag.MaxPrice" asp-route-categoryId="@ViewBag.CategoryId" class="join-item btn">«</a>
                    }
                    else
                    {
                        <button class="join-item btn btn-disabled">«</button>
                    }

                    <button class="join-item btn">Sayfa @Model.PageNumber / @Model.TotalPages</button>

                    @if (Model.HasNextPage)
                    {
                        <a asp-action="Index" asp-route-page="@(Model.PageNumber + 1)" asp-route-search="@ViewBag.Search" asp-route-minPrice="@ViewBag.MinPrice" asp-route-maxPrice="@ViewBag.MaxPrice" asp-route-categoryId="@ViewBag.CategoryId" class="join-item btn">»</a>
                    }
                    else
                    {
                        <button class="join-item btn btn-disabled">»</button>
                    }
                </div>
            }
        }
    </div>
</div>
