@model ikincelwebsitesi.Models.Listing

@{
    ViewData["Title"] = "İlanı Düzenle";
    var categories = ViewBag.Categories as List<ikincelwebsitesi.Models.Category>;
}

<div class="max-w-2xl mx-auto card bg-base-100 shadow-xl mt-8">
    <div class="card-body">
        <h2 class="card-title text-2xl font-bold mb-6">İlanı Düzenle</h2>

        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            
            <div class="form-control mb-4">
                <label class="label"><span class="label-text">İlan Başlığı</span></label>
                <input asp-for="Title" class="input input-bordered w-full" required />
            </div>

            <div class="form-control mb-4">
                <label class="label"><span class="label-text">Açıklama</span></label>
                <textarea asp-for="Description" class="textarea textarea-bordered h-32" required></textarea>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div class="form-control">
                    <label class="label"><span class="label-text">Fiyat (₺)</span></label>
                    <input asp-for="Price" type="number" step="0.01" class="input input-bordered w-full" required />
                </div>

                <div class="form-control">
                    <label class="label"><span class="label-text">Kategori</span></label>
                    <select asp-for="CategoryId" class="select select-bordered w-full" required>
                        @if (categories != null)
                        {
                            foreach (var cat in categories)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div class="form-control mb-6">
                <label class="label">
                    <span class="label-text">Yeni Görsel (Mevcudu Değiştirmek İçin)</span>
                    <span class="label-text-alt">Max 2MB - .jpg, .png, .webp</span>
                </label>
                <input type="file" name="imageFile" accept=".jpg,.jpeg,.png,.webp" class="file-input file-input-bordered w-full" />
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <p class="text-sm mt-2">Mevcut Görsel: <a href="@Model.ImageUrl" target="_blank" class="link link-primary">Görüntüle</a></p>
                }
            </div>

            <div class="card-actions justify-end mt-4">
                <a href="javascript:history.back()" class="btn btn-ghost">İptal</a>
                <button type="submit" class="btn btn-primary">Kaydet</button>
            </div>
        </form>
    </div>
</div>
