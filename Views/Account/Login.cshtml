@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="flex justify-center items-center h-full mt-12">
    <div class="card w-full max-w-md bg-base-100 shadow-xl">
        <div class="card-body">
            <h2 class="card-title text-2xl font-bold justify-center mb-4">Giriş Yap</h2>
            
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-error mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <span>Geçersiz giriş denemesi. Lütfen bilgilerinizi kontrol edin.</span>
                </div>
            }

            <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                <div class="form-control">
                    <label class="label"><span class="label-text">E-posta</span></label>
                    <input type="email" name="email" placeholder="admin@marketplace.com" class="input input-bordered" required />
                </div>
                
                <div class="form-control mt-4">
                    <label class="label"><span class="label-text">Şifre</span></label>
                    <input type="password" name="password" placeholder="Admin123!" class="input input-bordered" required />
                </div>
                
                <div class="form-control mt-8">
                    <button type="submit" class="btn btn-primary w-full">Giriş Yap</button>
                </div>

                <div class="text-center mt-4">
                    <span class="text-sm">Henüz bir hesabınız yok mu?</span>
                    <a asp-action="Register" class="link link-primary text-sm">Kayıt Ol</a>
                </div>
            </form>
        </div>
    </div>
</div>
