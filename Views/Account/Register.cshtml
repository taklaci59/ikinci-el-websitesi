@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="flex justify-center items-center h-full mt-12">
    <div class="card w-full max-w-md bg-base-100 shadow-xl">
        <div class="card-body">
            <h2 class="card-title text-2xl font-bold justify-center mb-4">Kayıt Ol</h2>
            
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-error mb-4">
                    <div class="flex-col">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <p class="text-sm">@error.ErrorMessage</p>
                        }
                    </div>
                </div>
            }

            <form asp-controller="Account" asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                <div class="form-control">
                    <label class="label"><span class="label-text">Tam Ad</span></label>
                    <input type="text" name="fullName" placeholder="John Doe" class="input input-bordered" required />
                </div>

                <div class="form-control mt-4">
                    <label class="label"><span class="label-text">E-posta</span></label>
                    <input type="email" name="email" placeholder="example@mail.com" class="input input-bordered" required />
                </div>
                
                <div class="form-control mt-4">
                    <label class="label"><span class="label-text">Şifre</span></label>
                    <input type="password" name="password" placeholder="******" class="input input-bordered" required />
                </div>
                
                <div class="form-control mt-8">
                    <button type="submit" class="btn btn-primary w-full">Kayıt Ol</button>
                </div>

                <div class="text-center mt-4">
                    <span class="text-sm">Zaten bir hesabınız var mı?</span>
                    <a asp-action="Login" class="link link-primary text-sm">Giriş Yap</a>
                </div>
            </form>
        </div>
    </div>
</div>
